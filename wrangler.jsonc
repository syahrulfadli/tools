{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productivity-tools",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // Tiap rute (/ dan /tools/<slug>) punya HTML sendiri hasil build (lihat build/seo.ts), jadi alamat
    // lain mendapat 404 sungguhan dari 404.html (SPA yang menampilkan halaman "tidak ada"). /api/* ditangani Worker.
    "not_found_handling": "404-page",
    // URL kanonik tanpa garis miring akhir (/tools/kolase); versi dengan garis miring dialihkan ke sana.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Sengaja TIDAK ada binding KV / R2 / D1: aplikasi ini tidak menyimpan data user.
}
